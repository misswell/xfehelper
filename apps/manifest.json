{
  "name": "XFeHelper - JSON格式化、编解码、二维码、开发者工具箱",
  "short_name": "XFeHelper",
  "version": "2026.7.34",
  "manifest_version": 3,
  "description": "30+款前端开发工具：JSON格式化、编解码、二维码、代码美化、正则、时间戳、UUID、图表、Excel转换等，全部功能默认启用，开箱即用。",
  "icons": {
    "16": "static/img/fe-16.png",
    "48": "static/img/fe-48.png",
    "128": "static/img/fe-128.png"
  },
  "action": {
    "default_icon": "static/img/fe-16.png",
    "default_title": "XFeHelper(前端助手)",
    "default_popup": "popup/index.html"
  },
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  },
  "permissions": [
    "alarms",
    "tabs",
    "scripting",
    "contextMenus",
    "activeTab",
    "storage",
    "notifications",
    "unlimitedStorage",
    "webNavigation"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "file://*/*"
    ],
  "optional_permissions": [
    "downloads"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+J"
      }
    }
  },
  "web_accessible_resources": [
      {
          "resources":[
            "static/img/fe-16.png",
            "static/img/fe-48.png",
            "static/img/loading.gif",
            "json-format/format-lib.js",
            "json-format/json-auto-utils.js",
            "json-format/json-abc.js",
            "json-format/json-bigint.js",
            "json-format/json-decode.js",
            "json-format/json-worker.js",
            "static/vendor/jquery/jquery-3.3.1.min.js",
            "static/vendor/evalCore.min.js",

            "background/awesome.js",
            "background/auto-install.js",
            "background/tools.js",

            "code-beautify/beautify.js",
            "code-beautify/beautify-css.js",
            "postman/sw.js"
        ],
        "matches": ["<all_urls>"]
      }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; style-src 'self' 'unsafe-inline'; object-src 'self'",
    "sandbox": "sandbox allow-scripts allow-forms allow-popups allow-modals; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'"
  },
  "sandbox": {
    "pages": [
      "dynamic/sandbox.html"
    ]
  },
  "update_url": "https://clients2.google.com/service/update2/crx",
  "homepage_url": "https://fehelper.com/",
  "author": "nicetool.net"
}
